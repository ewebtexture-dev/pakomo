# Copy to .env.local. Firebase Web configuration is managed at /admin/firebase.
# Contact / enquiry email is configured through Site Settings → SMTP.

# Blog backend canonical origin. Change this to your domain when hosting.
SITE_URL=http://localhost:3000
# DATA_DIRECTORY may be set to a persistent directory outside the project.
# ADMIN_USERNAME and ADMIN_PASSWORD may be set before running setup:admin.

# CMS encryption and password-reset defaults. Generate a random key; retain it in backups.
CMS_SECRET_KEY=
ADMIN_RESET_EMAIL=juhityagi09@gmail.com
# Trust proxy headers only when the hosting proxy overwrites client-supplied values.
TRUST_PROXY=0

# Optional SMTP defaults; the Super Admin can configure encrypted settings in the CMS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_EMAIL=info@pakmoo.in
