# Copy to .env.local and supply your Firebase project's configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Existing contact / quote integration
NEXT_EMAIL_TEMPLATEID=
NEXT_EMAIL_SERVICEID=
NEXT_EMAIL_PUBLICKEY=

# Blog backend canonical origin. Change this to your domain when hosting.
SITE_URL=http://localhost:3000
# DATA_DIRECTORY may be set to a persistent directory outside the project.
# ADMIN_USERNAME and ADMIN_PASSWORD may be set before running setup:admin.
